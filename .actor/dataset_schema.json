{
    "$schema": "https://apify.com/schemas/v1/dataset.ide.json",
    "actorSpecification": 1,
    "fields": {
        "rank": {"type": "integer", "description": "Recommendation rank."},
        "title": {"type": "string", "description": "Public video title."},
        "url": {"type": "string", "description": "Public video URL."},
        "views": {"type": "integer", "description": "Parsed public view count."},
        "rating": {"type": "number", "description": "Normalized public rating from 0 to 1."},
        "score": {"type": "number", "description": "Recommendation score from 0 to 1."}
    },
    "views": {
        "overview": {
            "title": "Overview",
            "transformation": {
                "fields": ["rank", "title", "url", "views", "rating", "score"]
            },
            "display": {
                "component": "table",
                "properties": {
                    "title": {
                        "label": "Title",
                        "format": "text"
                    },
                    "url": {
                        "label": "URL",
                        "format": "link"
                    },
                    "rank": {"label": "Rank", "format": "number"},
                    "views": {"label": "Views", "format": "number"},
                    "rating": {"label": "Rating", "format": "number"},
                    "score": {"label": "Score", "format": "number"}
                }
            }
        }
    }
}